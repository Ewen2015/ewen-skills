命令结果在两处都被硬编码的 90s 掐断：CLI 侧 `BridgePage.call` 的
接收等待，和服务端 `asyncio.wait_for`。正文是逐字输入的，900 字左右
就会超过 90s，命令直接报「命令执行超时（90s）」，而扩展其实还在继续
干活。

默认值放宽到 900s 并暴露 `XHS_CMD_TIMEOUT`。两侧读同一个变量，CLI 的
接收等待和服务端的等待不会脱节。

默认值必须留够余量，不能贴着"正常要多久"：`CMD_TIMEOUT` 是**进程启动
时**定死的，一个用旧默认起着的常驻 server 会占住端口，之后所有 CLI 都
连到它、拿到那个旧上限——此时只调 CLI 侧的环境变量没有任何作用。

为此 `ping_server` 顺带回报本进程实际生效的 `cmd_timeout`，调用方可以
据此发现"端口上是个旧进程"。
---
 scripts/bridge_server.py | 18 +++++++++++++++---
 scripts/xhs/bridge.py    | 21 ++++++++++++++++++++-
 2 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/scripts/bridge_server.py b/scripts/bridge_server.py
index e22fe33..e9a39e3 100644
--- a/scripts/bridge_server.py
+++ b/scripts/bridge_server.py
@@ -15,6 +15,7 @@ import argparse
 import asyncio
 import json
 import logging
+import os
 import sys
 import uuid
 from typing import Any
@@ -24,6 +25,12 @@ from websockets.server import ServerConnection
 
 logger = logging.getLogger("xhs-bridge")
 
+# 命令执行的墙钟上限。正文是逐字输入的，~900 字在 90s 内很勉强。
+# 默认 900s：这个值在**进程启动时**定死，一旦有一个用旧默认起着的常驻
+# server 占着 9333，之后所有 CLI 都会连到它、拿到那个旧上限——所以默认值
+# 必须留够余量，不能贴着"正常要多久"。可用 XHS_CMD_TIMEOUT 覆盖。
+CMD_TIMEOUT = float(os.environ.get("XHS_CMD_TIMEOUT", "900"))
+
 
 class BridgeServer:
     def __init__(self) -> None:
@@ -81,7 +88,12 @@ class BridgeServer:
         # 特殊命令：查询 server/extension 状态，无需转发
         if msg.get("method") == "ping_server":
             await ws.send(json.dumps({
-                "result": {"extension_connected": self._extension_ws is not None}
+                "result": {
+                    "extension_connected": self._extension_ws is not None,
+                    # 暴露本进程实际生效的超时，好让 CLI 发现"占着端口的
+                    # 是一个用旧上限起着的旧进程"并把它换掉。
+                    "cmd_timeout": CMD_TIMEOUT,
+                }
             }))
             return
 
@@ -99,11 +111,11 @@ class BridgeServer:
         await self._extension_ws.send(json.dumps(msg))
 
         try:
-            result = await asyncio.wait_for(future, timeout=90.0)
+            result = await asyncio.wait_for(future, timeout=CMD_TIMEOUT)
             await ws.send(json.dumps(result))
         except asyncio.TimeoutError:
             self._pending.pop(msg_id, None)
-            await ws.send(json.dumps({"error": "命令执行超时（90s）"}))
+            await ws.send(json.dumps({"error": f"命令执行超时（{int(CMD_TIMEOUT)}s）"}))
         except ConnectionError as e:
             await ws.send(json.dumps({"error": str(e)}))
 
diff --git a/scripts/xhs/bridge.py b/scripts/xhs/bridge.py
index 56886da..27d17d2 100644
--- a/scripts/xhs/bridge.py
+++ b/scripts/xhs/bridge.py
@@ -37,7 +37,11 @@ class BridgePage:
         try:
             with ws_client.connect(self._bridge_url, max_size=50 * 1024 * 1024) as ws:
                 ws.send(json.dumps(msg, ensure_ascii=False))
-                raw = ws.recv(timeout=90)
+                # 正文是逐字输入的，900 字左右会超过旧的 90s 硬编码上限。
+                # 默认 900s，可用 XHS_CMD_TIMEOUT 覆盖。注意这一侧只决定
+                # "客户端等多久"，服务端自己的墙钟是启动时定死的——见
+                # server_cmd_timeout()。
+                raw = ws.recv(timeout=float(os.environ.get("XHS_CMD_TIMEOUT", "900")))
         except OSError as e:
             raise CDPError(f"无法连接到 bridge server（ws://localhost:9333）: {e}") from e
 
@@ -279,6 +283,21 @@ class BridgePage:
         except Exception:
             return False
 
+    def server_cmd_timeout(self) -> float | None:
+        """问 bridge server 它自己实际生效的命令超时（秒）。
+
+        拿不到就返回 None。用来发现"端口上占着的是一个用旧上限起着的
+        常驻进程"——那种情况 CLI 侧调大 XHS_CMD_TIMEOUT 是没用的。
+        """
+        try:
+            with ws_client.connect(self._bridge_url, open_timeout=3) as ws:
+                ws.send(json.dumps({"role": "cli", "method": "ping_server"}))
+                raw = ws.recv(timeout=5)
+            value = json.loads(raw).get("result", {}).get("cmd_timeout")
+            return float(value) if value is not None else None
+        except Exception:
+            return None
+
     def is_extension_connected(self) -> bool:
         """检查浏览器扩展是否已连接到 bridge server。"""
         try:
